# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenHere

# ID Google Таблицы — это часть URL между /d/ и /edit
# https://docs.google.com/spreadsheets/d/ЭТОТ_ID/edit
SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Путь к JSON-ключу сервисного аккаунта Google (локальный запуск / Raspberry Pi)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Альтернатива для облачных платформ без загрузки файлов (Railway и т.п.):
# вставьте всё содержимое credentials.json одной строкой сюда, тогда
# GOOGLE_CREDENTIALS_PATH выше можно не указывать
# GOOGLE_CREDENTIALS_JSON={"type": "service_account", ...}

# Ежедневный автоматический дайджест (необязательно) — узнать chat_id
# можно командой /chatid прямо в чате с ботом
# DIGEST_CHAT_ID=-1001234567890
# DIGEST_TIME=08:00
# DIGEST_TIMEZONE=Europe/Helsinki
